@implements IDisposable
@inject ReduxStore Store

<div class="debug-grid">
    <section class="card store-card">
        <div class="card-header">
            <h2 class="h5 mb-1">Current state</h2>
            <p class="text-muted small mb-0">The reducer output serialized from the live store.</p>
        </div>
        <div class="card-body">
            <pre class="debug-json">@Store.CurrentStateJson</pre>
        </div>
    </section>

    <section class="card store-card">
        <div class="card-header">
            <h2 class="h5 mb-1">Action history</h2>
            <p class="text-muted small mb-0">Newest snapshots first, similar to a lightweight Redux devtools timeline.</p>
        </div>
        <div class="card-body">
            <div class="history-list">
                @foreach (var entry in Store.History)
                {
                    <details open="@(entry.Sequence == Store.History.First().Sequence)">
                        <summary>
                            <div class="d-flex justify-content-between align-items-center gap-3 flex-wrap">
                                <div>
                                    <div class="fw-semibold">@entry.ActionType</div>
                                    <div class="text-muted small">#@entry.Sequence · @entry.OccurredAt.ToLocalTime().ToString("T")</div>
                                </div>
                                <span class="badge text-bg-light border">@entry.TodoCount todos</span>
                            </div>
                        </summary>
                        <pre class="debug-json mt-3">@entry.StateJson</pre>
                    </details>
                }
            </div>
        </div>
    </section>
</div>

@code {
    private IDisposable? _subscription;

    protected override void OnInitialized()
    {
        _subscription = Store.States.Subscribe(state =>
        {
            _ = InvokeAsync(StateHasChanged);
        });
    }

    public void Dispose() => _subscription?.Dispose();
}
