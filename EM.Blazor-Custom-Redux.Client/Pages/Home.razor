@page "/"
@rendermode InteractiveWebAssembly

<PageTitle>Todo Store — WASM</PageTitle>

<div class="hero-panel mb-4">
    <span class="badge rounded-pill text-bg-primary mb-3">Blazor WebAssembly + Rx.NET + Custom Redux</span>
    <h1>Shared immutable todo state across multiple components</h1>
    <p class="lead mb-2">
        This demo runs entirely in the browser as <strong>Blazor WebAssembly</strong>. The store is registered as a
        <code>Singleton</code> — safe here because each browser tab is its own isolated process with a single user.
    </p>
    <p class="lead mb-0">
        Browser <strong>localStorage persistence</strong> is opted in via <code>.WithLocalStoragePersistence&lt;AppState&gt;()</code>
        in the WASM <code>Program.cs</code> — it is not part of the core store and is not available on the server.
        Update a todo anywhere and every connected component reacts to the same state immediately.
    </p>
</div>

<div class="row g-4">
    <div class="col-12 col-xxl-4">
        <TodoComposer />
        <TodoStatsPanel class="mt-4" />
    </div>

    <div class="col-12 col-xxl-8">
        <TodoListPanel />
    </div>

    <div class="col-12">
        <TodoMirrorPanel />
    </div>
</div>
