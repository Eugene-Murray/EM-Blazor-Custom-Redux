@inject ReduxStore<ServerCounterState> Store

<div class="card store-card">
	<div class="card-header">
		<h2 class="h5 mb-1">Dispatch actions</h2>
		<p class="text-muted small mb-0">
			Actions flow through the reducer and the updated state is pushed to every subscriber.
			No localStorage — the counter resets when you close this tab.
		</p>
	</div>
	<div class="card-body d-flex gap-2 flex-wrap">
		<button class="btn btn-success" @onclick="Increment">
			Dispatch IncrementCounterAction
		</button>
		<button class="btn btn-warning" @onclick="Decrement">
			Dispatch DecrementCounterAction
		</button>
		<button class="btn btn-outline-secondary" @onclick="Reset">
			Dispatch ResetCounterAction
		</button>
	</div>
</div>

@code {
	private void Increment() => Store.Dispatch(new IncrementCounterAction());
	private void Decrement() => Store.Dispatch(new DecrementCounterAction());
	private void Reset()     => Store.Dispatch(new ResetCounterAction());
}
