@typeparam TState
@implements IDisposable
@inject ReduxStore<TState> Store

<div @attributes="AdditionalAttributes" class="redux-debug-grid">
    <section class="card redux-debug-card">
        <div class="card-header">
            <h2 class="h5 mb-1">Current state</h2>
            <p class="text-muted small mb-0">The latest immutable snapshot serialized directly from the store.</p>
        </div>
        <div class="card-body">
            <pre class="redux-debug-json">@Store.CurrentStateJson</pre>
        </div>
    </section>

    <section class="card redux-debug-card">
        <div class="card-header">
            <h2 class="h5 mb-1">Action history</h2>
            <p class="text-muted small mb-0">Newest entries first, with reducer snapshots captured after each dispatch.</p>
        </div>
        <div class="card-body">
            <div class="redux-history-list">
                @foreach (var entry in Store.History)
                {
                    <details open="@ReferenceEquals(entry, Store.History.FirstOrDefault())">
                        <summary>
                            <div class="d-flex justify-content-between align-items-center gap-3 flex-wrap">
                                <div>
                                    <div class="fw-semibold">@entry.ActionType</div>
                                    <div class="text-muted small">#@entry.Sequence · @entry.OccurredAt.ToLocalTime().ToString("T")</div>
                                </div>
                            </div>
                        </summary>
                        <pre class="redux-debug-json mt-3">@entry.StateJson</pre>
                    </details>
                }
            </div>
        </div>
    </section>
</div>

@code {
    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private IDisposable? _subscription;

    protected override void OnInitialized()
    {
        _subscription = Store.States.Subscribe(state =>
        {
            _ = InvokeAsync(StateHasChanged);
        });
    }

    public void Dispose() => _subscription?.Dispose();
}
